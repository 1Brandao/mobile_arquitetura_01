@startuml uml_classes
!theme plain
left to right direction

skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam packageFontSize 12
skinparam packageBorderColor #555555
skinparam packageBorderThickness 1.5
skinparam classBorderColor #333333
skinparam classBackgroundColor #FFFFFF
skinparam arrowColor #444444
skinparam shadowing false
skinparam padding 5
skinparam nodesep 25
skinparam ranksep 45

title Diagrama de Classes — mobile_arquitetura_02\n<size:10>(Clean Architecture · Flutter · Provider / ChangeNotifier)</size>

' ─────────────────────────────────────────────
'  CORE
' ─────────────────────────────────────────────
package "core" #EEF2FF {

  class AppRoutes {
    + {static} homePage     : String = '/'
    + {static} productsPage : String = '/products'
    + {static} detailsPage  : String = '/details'
    + {static} formPage     : String = '/form'
    + {static} loginPage    : String = '/login'
  }

  class Failure implements Exception {
    + message : String
    --
    + Failure(message : String)
  }

  class UserSession extends ChangeNotifier {
    - _user : User?
    --
    + user       : User?  <<get>>
    + isLoggedIn : bool   <<get>>
    --
    + login(user : User) : void
    + logout()           : void
  }
}

' ─────────────────────────────────────────────
'  DOMAIN
' ─────────────────────────────────────────────
package "domain" #E8F5E9 {

  class User {
    + id        : int
    + username  : String
    + firstName : String
    + lastName  : String
    + email     : String
    + token     : String
    --
    + User({required id, required username,\n    required firstName, required lastName,\n    required email, required token})
    + fullName  : String  <<get>>
  }

  class Product {
    + id          : int
    + title       : String
    + price       : double
    + description : String
    + image       : String
    + category    : String
    + ratingRate  : double
    + ratingCount : int
    + isFavorited : bool
    --
    + Product({required id : int,\n    required title : String,\n    required price : double,\n    required description : String,\n    required image : String,\n    required category : String,\n    required ratingRate : double,\n    required ratingCount : int,\n    isFavorited : bool = false})
    + copyWith(...) : Product
  }

  abstract class AuthRepository {
    + login(username : String, password : String) : Future<User>
  }

  abstract class ProductRepository {
    + getProducts()                         : Future<List<Product>>
    + toggleFavorite(productId : int)       : Future<Product>
    + addProduct(product : Product)         : Future<Product>
    + updateProduct(product : Product)      : Future<Product>
    + deleteProduct(id : int)              : Future<void>
  }
}

' ─────────────────────────────────────────────
'  DATA
' ─────────────────────────────────────────────
package "data" #FFF8E1 {

  class UserModel {
    + id        : int
    + username  : String
    + firstName : String
    + lastName  : String
    + email     : String
    + token     : String
    --
    + UserModel({required id, required username,\n    required firstName, required lastName,\n    required email, required token})
    + {static} fromJson(json : Map<String,dynamic>) : UserModel
    + toEntity()                                    : User
  }

  class AuthRemoteDatasource {
    - client                    : http.Client
    - {static} {const} _baseUrl : String
    --
    + AuthRemoteDatasource(client : http.Client)
    + login(username : String, password : String) : Future<UserModel>
  }

  class AuthRepositoryImpl implements AuthRepository {
    + remote : AuthRemoteDatasource
    --
    + AuthRepositoryImpl(remote)
    + login(username, password) : Future<User>
  }

  class ProductModel {
    + id          : int
    + title       : String
    + price       : double
    + description : String
    + image       : String
    + category    : String
    + ratingRate  : double
    + ratingCount : int
    + isFavorited : bool
    --
    + ProductModel({required id : int,\n    required title : String,\n    required price : double,\n    required description : String,\n    required image : String,\n    required category : String,\n    required ratingRate : double,\n    required ratingCount : int,\n    isFavorited : bool = false})
    + {static} fromJson(json)  : ProductModel
    + {static} fromCache(json) : ProductModel
    + toJson()                 : Map<String,dynamic>
    + toCache()                : Map<String,dynamic>
    + copyWith(...)            : ProductModel
  }

  class ProductRemoteDatasource {
    - client                    : http.Client
    - {static} {const} _baseUrl : String
    --
    + ProductRemoteDatasource(client : http.Client)
    + getProducts()                         : Future<List<ProductModel>>
    + addProduct(product : ProductModel)    : Future<ProductModel>
    + updateProduct(product : ProductModel) : Future<ProductModel>
    + deleteProduct(id : int)               : Future<void>
  }

  class ProductCacheDatasource {
    - _cache : List<ProductModel>?
    --
    + save(products : List<ProductModel>) : void
    + get()                               : List<ProductModel>?
  }

  class ProductRepositoryImpl implements ProductRepository {
    + remote : ProductRemoteDatasource
    + cache  : ProductCacheDatasource
    --
    + ProductRepositoryImpl(remote, cache)
    - _toEntity(m)            : Product
    - _toModel(p)             : ProductModel
    + getProducts()           : Future<List<Product>>
    + toggleFavorite(id)      : Future<Product>
    + addProduct(product)     : Future<Product>
    + updateProduct(product)  : Future<Product>
    + deleteProduct(id)       : Future<void>
  }
}

' ─────────────────────────────────────────────
'  PRESENTATION
' ─────────────────────────────────────────────
package "presentation" #FCE4EC {

  class AuthViewmodel extends ChangeNotifier {
    + repository : AuthRepository
    + session    : UserSession
    - _isLoading : bool
    - _error     : String?
    --
    + isLoading  : bool    <<get>>
    + error      : String? <<get>>
    --
    + AuthViewmodel(repository, session)
    + login(username : String, password : String) : Future<bool>
    + logout()                                    : void
  }

  class ProductViewmodel extends ChangeNotifier {
    + repository         : ProductRepository
    - _showOnlyFavorites : bool
    - _isLoading         : bool
    - _products          : List<Product>
    - _error             : String?
    --
    + showOnlyFavorites : bool  <<get>>
    + isLoading         : bool  <<get>>
    + products          : UnmodifiableListView<Product> <<get>>
    + error             : String? <<get>>
    + favoriteCount     : int  <<get>>
    --
    + ProductViewmodel(repository)
    + loadProducts()            : Future<void>
    + setShowOnlyFavorites(v)   : void
    + toggleFavorite(productId) : Future<void>
    + addProduct(product)       : Future<bool>
    + updateProduct(product)    : Future<bool>
    + deleteProduct(id)         : Future<bool>
  }

  class MyApp <<StatefulWidget>> {
    + repository     : ProductRepositoryImpl
    + authRepository : AuthRepository
    + userSession    : UserSession
    --
    + MyApp(repository, authRepository, userSession)
    + createState()  : State
  }

  class LoginPage <<StatefulWidget>> {
    --
    + createState() : _LoginPageState
  }

  class _LoginPageState <<State>> {
    - _formKey            : GlobalKey<FormState>
    - _usernameController : TextEditingController
    - _passwordController : TextEditingController
    - _obscurePassword    : bool
    --
    + dispose()      : void
    - _submit()      : Future<void>
    + build(context) : Widget
  }

  class HomePage <<StatelessWidget>> {
    --
    + build(context) : Widget
  }

  class ProductPage <<StatelessWidget>> {
    --
    + build(context) : Widget
    - _confirmDelete(context, viewmodel, productId, title) : Future<void>
  }

  class ProductDetailPage <<StatelessWidget>> {
    --
    + build(context) : Widget
    - _confirmDelete(context, viewmodel, productId, title) : Future<void>
  }

  class _CategoryBadge <<StatelessWidget>> {
    + category : String
    --
    + build(context) : Widget
  }

  class _RatingBadge <<StatelessWidget>> {
    + rate  : double
    + count : int
    --
    + build(context) : Widget
  }

  class ProductFormPage <<StatefulWidget>> {
    --
    + createState() : _ProductFormPageState
  }

  class _ProductFormPageState <<State>> {
    - _formKey               : GlobalKey<FormState>
    - _titleController       : TextEditingController
    - _priceController       : TextEditingController
    - _descriptionController : TextEditingController
    - _categoryController    : TextEditingController
    - _imageController       : TextEditingController
    - _editingProduct        : Product?
    - _isLoading             : bool
    - _isEditing             : bool  <<get>>
    --
    + didChangeDependencies() : void
    + dispose()               : void
    - _submit()               : Future<void>
    + build(context)          : Widget
  }
}

' ─────────────────────────────────────────────
'  RELACIONAMENTOS
' ─────────────────────────────────────────────

' Auth — Implementação
AuthRepositoryImpl   ..|> AuthRepository       : implements

' Auth — Data
AuthRepositoryImpl   --> AuthRemoteDatasource  : usa
AuthRemoteDatasource ..> UserModel             : cria / retorna
AuthRepositoryImpl   ..> User                 : mapeia via toEntity
UserModel            ..> User                 : converte via toEntity()

' Auth — Session & Presentation
UserSession          o-- "0..1" User          : mantém
AuthViewmodel        --> AuthRepository       : depende de
AuthViewmodel        --> UserSession          : depende de

' Product — Implementação
ProductRepositoryImpl ..|> ProductRepository  : implements

' Product — Data
ProductRepositoryImpl --> ProductRemoteDatasource : usa
ProductRepositoryImpl --> ProductCacheDatasource  : usa
ProductRepositoryImpl ..> Failure                 : throws
ProductRemoteDatasource ..> ProductModel          : cria / retorna
ProductCacheDatasource  *-- "0..*" ProductModel   : armazena
ProductRepositoryImpl   ..> Product               : mapeia via _toEntity/_toModel

' Presentation — Provider
ProductViewmodel --> ProductRepository        : depende de
ProductViewmodel o-- "0..*" Product           : mantém lista

MyApp --> ProductRepositoryImpl               : injeta via ChangeNotifierProvider
MyApp --> AuthRepositoryImpl                  : injeta
MyApp --> UserSession                         : injeta
MyApp ..> ProductViewmodel                    : cria via Provider
MyApp ..> AuthViewmodel                       : cria via Provider
MyApp ..> AppRoutes                           : usa rotas

LoginPage        *-- _LoginPageState          : compõe
_LoginPageState  ..> AuthViewmodel            : usa via Provider
_LoginPageState  ..> AppRoutes               : navega com

HomePage          ..> AppRoutes              : navega com
HomePage          ..> UserSession            : lê nome do usuário
ProductPage       ..> AppRoutes              : navega com
ProductDetailPage ..> AppRoutes              : navega com
ProductFormPage   *-- _ProductFormPageState  : compõe

ProductDetailPage *-- _CategoryBadge         : compõe
ProductDetailPage *-- _RatingBadge           : compõe

@enduml
